<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.github.adachi-tatsuru.machealth.docker</string>
    <key>ProgramArguments</key>
    <array>
        <string>{{HOME}}/.local/bin/mac-health/bin/check-docker.sh</string>
    </array>
    <key>StartInterval</key>
    <integer>600</integer>
    <key>RunAtLoad</key>
    <false/>
    <key>StandardOutPath</key>
    <string>{{HOME}}/Library/Logs/MacHealth/launchd.docker.out</string>
    <key>StandardErrorPath</key>
    <string>{{HOME}}/Library/Logs/MacHealth/launchd.docker.err</string>
</dict>
</plist>
